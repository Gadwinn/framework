{
    "name": "gadwinn/framework",
    "description": "Lightweight PSR-7/PSR-15 framework assembling the gadwinn/* packages.",
    "type": "library",
    "minimum-stability": "stable",
    "license": "MIT",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "G\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G\\Framework\\Tests\\": "tests/",
            "G\\Framework\\Tests\\Fixtures\\App\\": "tests/Fixtures/app/src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "gadwinn/psr-http-message": "^0.1",
        "gadwinn/psr-http-server-handler": "^0.1",
        "gadwinn/router": "^0.1",
        "gadwinn/psr-container": "^0.1.1",
        "gadwinn/http-emitter": "^0.1 || ^0.2"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest@dev",
        "phpdocumentor/shim": "*",
        "phpstan/phpstan": "*",
        "phpunit/phpunit": "*",
        "povils/phpmnd": "*",
        "squizlabs/php_codesniffer": "*"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    },
    "scripts": {
        "install-prod": "composer install --no-dev --classmap-authoritative",
        "gen-docs": "php vendor/bin/phpdoc -d src -t docs/phpdoc",
        "test-all": [
            "@security-audit",
            "@test-phpcbf",
            "@test-cs",
            "@test-stan",
            "@test-unit",
            "@test-mnd"
        ],
        "security-audit": "composer audit --no-dev --format=summary --abandoned=report",
        "test-phpcbf": "php vendor/bin/phpcbf || exit 0",
        "test-cs": "php vendor/bin/phpcs",
        "test-stan": "php vendor/bin/phpstan",
        "test-unit": "php vendor/bin/phpunit --no-coverage",
        "test-unit-coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text",
        "test-mnd": "php vendor/bin/phpmnd ./src --hint --progress --strings --extensions=assign,operation,return,condition,switch_case"
    },
    "scripts-descriptions": {
        "install-prod": "Install dependencies for production environment",
        "gen-docs": "Generate API documentation using PHPDoc",
        "test-all": "Run the complete test suite including all quality checks",
        "security-audit": "Check for security vulnerabilities in dependencies",
        "test-phpcbf": "Automatically fix code style issues using PHP Code Beautifier and Fixer",
        "test-cs": "Run code style checks using PHP_CodeSniffer",
        "test-stan": "Run static analysis using PHPStan",
        "test-unit": "Run unit tests with PHPUnit",
        "test-unit-coverage": "Run unit tests with PHPUnit and generate code coverage report",
        "test-mnd": "Detect magic numbers in the codebase"
    },
    "suggest": {
        "gadwinn/trusted-proxy-middleware": "Client IP, scheme and host behind a reverse proxy",
        "gadwinn/error-catcher-middleware": "Turns uncaught exceptions and PHP errors into error responses",
        "gadwinn/fail-sentry-middleware": "Blocks the IP addresses that keep failing",
        "gadwinn/http-method-middleware": "HTTP method override and body parsing for PUT/PATCH/DELETE",
        "gadwinn/csrf": "CSRF protection",
        "gadwinn/dotenv": "Loads the .env files",
        "gadwinn/psr-log": "PSR-3 logger",
        "gadwinn/psr-simple-cache": "PSR-16 cache (memory or files)",
        "gadwinn/psr-event-dispatcher": "PSR-14 event dispatcher",
        "gadwinn/psr-clock": "PSR-20 clock",
        "gadwinn/psr-http-client": "PSR-18 HTTP client (cURL)",
        "gadwinn/orm": "Database access",
        "gadwinn/translator": "Translations",
        "gadwinn/validator": "Validation of values and objects",
        "gadwinn/jwt": "JSON Web Tokens",
        "gadwinn/debug": "Debug bar for development"
    }
}
